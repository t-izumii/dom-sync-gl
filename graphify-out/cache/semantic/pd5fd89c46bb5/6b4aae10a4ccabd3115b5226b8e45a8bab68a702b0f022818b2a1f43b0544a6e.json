{"nodes": [{"id": "docs_api_dom_text_plane_domtextplane", "label": "DomTextPlane", "file_type": "document", "source_file": "docs/api/dom-text-plane.md", "source_location": "lines 1-13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_dom_text_plane_computed_style_pipeline", "label": "getComputedStyle rasterization pipeline", "file_type": "rationale", "source_file": "docs/api/dom-text-plane.md", "source_location": "\u4f55\u3092\u3059\u308b\u30af\u30e9\u30b9\u304b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Styles are always read from getComputedStyle so fluid values like font-size: clamp(...) resolve on their own and breakpoints never have to be duplicated in JS - the way to change the plane's look is to edit CSS, not JS."}, {"id": "docs_api_dom_text_plane_color_transparent_hiding", "label": "color: transparent text hiding", "file_type": "rationale", "source_file": "docs/api/dom-text-plane.md", "source_location": "\u306a\u305c display: none \u306b\u3057\u306a\u3044\u306e\u304b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "visibility / display / opacity are deliberately avoided: making the text transparent keeps layout, accessibility (screen readers), SEO and text selection intact in the DOM while only the visual layer moves to WebGL."}, {"id": "docs_api_dom_text_plane_createtextplaneoptions", "label": "CreateTextPlaneOptions", "file_type": "concept", "source_file": "docs/api/dom-text-plane.md", "source_location": "Options", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_dom_text_plane_textstyleoverrides", "label": "TextStyleOverrides", "file_type": "concept", "source_file": "docs/api/dom-text-plane.md", "source_location": "TextStyleOverrides", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_dom_text_plane_text_layout_rules", "label": "Text layout rules (paragraphs, wrapping, 4096px clamp)", "file_type": "rationale", "source_file": "docs/api/dom-text-plane.md", "source_location": "\u30c6\u30ad\u30b9\u30c8\u306e\u6271\u3044", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canvas side length is clamped at 4096px so a huge element on a high-DPR screen cannot blow out VRAM. Because textContent is used verbatim, HTML indentation newlines also become paragraph breaks - write the text on one line or pass the text option."}, {"id": "docs_api_dom_text_plane_font_ready_wait", "label": "document.fonts.ready wait before first rasterize", "file_type": "rationale", "source_file": "docs/api/dom-text-plane.md", "source_location": "\u30d5\u30a9\u30f3\u30c8\u306e\u8aad\u307f\u8fbc\u307f\u5f85\u3061", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first rasterization waits on document.fonts.ready so text is not baked with the pre-webfont fallback face; if fonts are already loaded it draws immediately."}], "edges": [{"source": "docs_api_dom_text_plane_domtextplane", "target": "docs_api_dom_plane_domplane", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/dom-text-plane.md", "source_location": "DomPlane \u3092\u7d99\u627f", "weight": 1.0}, {"source": "docs_api_dom_text_plane_domtextplane", "target": "docs_api_dom_text_plane_computed_style_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/dom-text-plane.md", "source_location": "\u4f55\u3092\u3059\u308b\u30af\u30e9\u30b9\u304b", "weight": 1.0}, {"source": "docs_api_dom_text_plane_computed_style_pipeline", "target": "docs_api_dom_text_plane_color_transparent_hiding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/dom-text-plane.md", "source_location": "step 4", "weight": 1.0}, {"source": "docs_api_dom_text_plane_createtextplaneoptions", "target": "docs_api_dom_plane_createplaneoptions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/dom-text-plane.md", "source_location": "CreatePlaneOptions \u3092\u7d99\u627f", "weight": 1.0}, {"source": "docs_api_dom_text_plane_createtextplaneoptions", "target": "docs_api_dom_text_plane_textstyleoverrides", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/dom-text-plane.md", "source_location": "style option", "weight": 1.0}, {"source": "docs_api_dom_text_plane_computed_style_pipeline", "target": "docs_api_load_font_resolvetextstyle", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/api/dom-text-plane.md", "source_location": "getComputedStyle \u7531\u6765\u306e\u30b9\u30bf\u30a4\u30eb\u89e3\u6c7a", "weight": 1.0}, {"source": "docs_api_dom_text_plane_text_layout_rules", "target": "docs_api_load_font_layoutlines", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/api/dom-text-plane.md", "source_location": "\u6298\u308a\u8fd4\u3057 / 4096px \u30af\u30e9\u30f3\u30d7", "weight": 1.0}, {"source": "docs_api_dom_text_plane_text_layout_rules", "target": "docs_api_load_font_rasterizetext", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/api/dom-text-plane.md", "source_location": "4096px \u30af\u30e9\u30f3\u30d7", "weight": 1.0}, {"source": "docs_api_dom_text_plane_font_ready_wait", "target": "docs_api_load_font_loadfont", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/dom-text-plane.md", "source_location": "\u30d5\u30a9\u30f3\u30c8\u306e\u8aad\u307f\u8fbc\u307f\u5f85\u3061", "weight": 1.0}], "hyperedges": []}