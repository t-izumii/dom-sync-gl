{"nodes": [{"id": "_claude_skills_graphify_skill_graphify", "label": "graphify skill", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "frontmatter + Usage", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_pipeline", "label": "graphify build pipeline (Steps 0-9)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Steps 0-9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_fast_path_existing_graph", "label": "Fast path for an existing graph", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "What You Must Do When Invoked", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json already exists and the request is a natural-language codebase question, Steps 1-5 are skipped entirely and graphify query runs immediately - rebuilding a graph that is already built wastes tokens and time."}, {"id": "_claude_skills_graphify_skill_ast_extraction", "label": "Structural (AST) extraction - Part A", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code is extracted deterministically with no LLM and no API key at all, so a code-only corpus skips semantic extraction entirely and costs nothing."}, {"id": "_claude_skills_graphify_skill_semantic_extraction", "label": "Semantic extraction via parallel subagents - Part B", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subagents must be dispatched in ONE message so they run in parallel, and must be general-purpose (Explore is read-only and silently drops chunk files). Reading files one-by-one is 5-10x slower."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Semantic extraction cache (prompt-attributed)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step B0 / B3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache entries are stamped with the extraction prompt (SPEC_PATH) that produced them so an upgraded prompt re-extracts instead of replaying stale results (#1939)."}, {"id": "_claude_skills_graphify_skill_no_api_key_policy", "label": "No API key required policy", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 preamble", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify never reads ANTHROPIC_API_KEY or OPENAI_API_KEY; Gemini is used only when GEMINI_API_KEY/GOOGLE_API_KEY happens to be set, otherwise the host agent itself is the LLM. Prompting for a key is a misread of the skill."}, {"id": "_claude_skills_graphify_skill_community_detection", "label": "Community detection and labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4 / Step 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_god_nodes", "label": "God nodes and surprising connections", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4 / Step 9 report", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graph_health_check", "label": "Graph health check (integrity gate)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only and never aborts: it surfaces edge collapse, dangling/missing endpoints and self-loops - the silent-corruption modes of incremental updates and AST/LLM id mismatches - without blocking a usable graph."}, {"id": "_claude_skills_graphify_skill_shrink_guard", "label": "graph.json shrink guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write when the new graph is smaller than the existing graph.json, and GRAPH_REPORT.md plus the analysis sidecar are only written after a successful write, so they never describe a graph graph.json does not contain (#1392)."}, {"id": "_claude_skills_graphify_skill_manifest", "label": "Extraction manifest and stamping", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files that actually produced output are stamped; a detected file whose chunk failed must stay unstamped so the next --update re-queues it, otherwise its content is lost forever (#2015)."}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Honesty Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS), never skip the corpus warning, always show token cost, never hide cohesion behind symbols, never run HTML viz above 5000 nodes without warning - the audit trail is the product."}, {"id": "_claude_skills_graphify_skill_cost_tracker", "label": "Cumulative token cost tracker (cost.json)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_graphify_skill_graphify", "target": "_claude_skills_graphify_skill_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Steps 0-9", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_skill_ast_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part A", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_skill_semantic_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part B", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_semantic_extraction", "target": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step B2", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_semantic_extraction", "target": "_claude_skills_graphify_skill_extraction_cache", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step B0 / B3", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_extraction_cache", "target": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "SPEC_PATH note", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_no_api_key_policy", "target": "_claud