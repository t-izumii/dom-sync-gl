{"nodes": [{"id": "docs_api_load_font_loadfont", "label": "loadFont()", "file_type": "document", "source_file": "docs/api/load-font.md", "source_location": "lines 1-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never rejects on failure - it warns and resolves so callers do not need a catch everywhere and CSS fallbacks simply take over. Failed fonts are dropped from the cache so a transient network error can be retried, successful ones are never re-fetched."}, {"id": "docs_api_load_font_separation_from_domtextplane", "label": "Font loading separated from DomTextPlane", "file_type": "rationale", "source_file": "docs/api/load-font.md", "source_location": "DomTextPlane \u3068\u306f\u5206\u96e2\u3055\u308c\u3066\u3044\u308b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetching and registering fonts is not DomTextPlane's responsibility; loadFont only adds to document.fonts while createTextPlane keeps reading getComputedStyle, which is what lets CSS (including clamp() fluid values) stay the single source of truth for font-size/weight."}, {"id": "docs_api_load_font_fontfacesource", "label": "FontFaceSource", "file_type": "concept", "source_file": "docs/api/load-font.md", "source_location": "FontFaceSource", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_load_font_resolvetextstyle", "label": "resolveTextStyle()", "file_type": "concept", "source_file": "docs/api/load-font.md", "source_location": "\u4f4e\u30ec\u30d9\u30eb API", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_load_font_layoutlines", "label": "layoutLines()", "file_type": "concept", "source_file": "docs/api/load-font.md", "source_location": "\u4f4e\u30ec\u30d9\u30eb API", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_load_font_rasterizetext", "label": "rasterizeText()", "file_type": "concept", "source_file": "docs/api/load-font.md", "source_location": "\u4f4e\u30ec\u30d9\u30eb API", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_api_load_font_separation_from_domtextplane", "target": "docs_api_dom_text_plane_domtextplane", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/load-font.md", "source_location": "DomTextPlane \u3068\u306f\u5206\u96e2\u3055\u308c\u3066\u3044\u308b", "weight": 1.0}, {"source": "docs_api_load_font_loadfont", "target": "docs_api_load_font_fontfacesource", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/load-font.md", "source_location": "Signature", "weight": 1.0}, {"source": "docs_api_load_font_rasterizetext", "target": "docs_api_load_font_resolvetextstyle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/load-font.md", "source_location": "style: ResolvedTextStyle", "weight": 1.0}, {"source": "docs_api_load_font_rasterizetext", "target": "docs_api_load_font_layoutlines", "relation": "calls", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/api/load-font.md", "source_location": "\u4f4e\u30ec\u30d9\u30eb API", "weight": 1.0}], "hyperedges": []}