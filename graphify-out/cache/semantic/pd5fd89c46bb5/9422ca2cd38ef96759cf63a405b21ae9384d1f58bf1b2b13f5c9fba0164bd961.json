{"nodes": [{"id": "docs_api_scroll_scrollsync", "label": "ScrollSync", "file_type": "document", "source_file": "docs/api/scroll.md", "source_location": "lines 1-18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_scroll_rafscroll_removed", "label": "RafScroll (removed)", "file_type": "rationale", "source_file": "docs/api/scroll.md", "source_location": "RafScroll \u306f\u5ec3\u6b62\u3055\u308c\u305f", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Lenis wrapper was deleted on the principle that smooth scrolling is an application concern, not something the library should own; the rafScroll option and getRafScroll() went with it."}, {"id": "docs_api_scroll_overscan", "label": "overscan", "file_type": "concept", "source_file": "docs/api/scroll.md", "source_location": "overscan", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends canvas height to viewportHeight + 2*overscan so a mobile URL-bar resize cannot expose a clipped canvas edge. 'auto' only pays that cost under (pointer: coarse) - 0 on mouse environments - so the default protects touch devices without wasting desktop pixels. Falls back to 0 where window.matchMedia is missing (SSR)."}, {"id": "docs_api_scroll_attach", "label": "attach ('translate' | 'dom')", "file_type": "concept", "source_file": "docs/api/scroll.md", "source_location": "attach", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'dom' respects the container's own CSS placement and never overwrites position/size/transform, but a non-fixed container scrolls with the page so canvasRect goes stale and DomPlane can drift; overscan does not apply."}, {"id": "docs_api_scroll_computeeffectivescrolly", "label": "ScrollSync.computeEffectiveScrollY()", "file_type": "concept", "source_file": "docs/api/scroll.md", "source_location": "static computeEffectiveScrollY", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns -document.documentElement.getBoundingClientRect().top, which equals window.scrollY normally but goes negative during an iOS Safari top rubber-band because it folds in the visual viewport offset."}, {"id": "docs_api_scroll_strength", "label": "strength / trackStrength", "file_type": "concept", "source_file": "docs/api/scroll.md", "source_location": "strength tip", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracking is opt-in: reading strength with trackStrength: false always returns 0 and DEV warns once, so the cost is not paid unless the effect actually needs scroll velocity."}, {"id": "docs_api_scroll_lenis_integration", "label": "Lenis integration (single rAF)", "file_type": "concept", "source_file": "docs/api/scroll.md", "source_location": "Lenis \u3068\u7d44\u307f\u5408\u308f\u305b\u308b", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_api_scroll_scrollsync", "target": "docs_api_scroll_overscan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "Options", "weight": 1.0}, {"source": "docs_api_scroll_scrollsync", "target": "docs_api_scroll_attach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "Options", "weight": 1.0}, {"source": "docs_api_scroll_scrollsync", "target": "docs_api_scroll_strength", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "Options", "weight": 1.0}, {"source": "docs_api_scroll_scrollsync", "target": "docs_api_scroll_computeeffectivescrolly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "static computeEffectiveScrollY", "weight": 1.0}, {"source": "docs_api_scroll_computeeffectivescrolly", "target": "docs_api_dom_plane_domplane", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "plane \u3068\u540c\u4e00\u306e effectiveScrollY \u3092\u6e21\u3059\u3053\u3068", "weight": 1.0}, {"source": "docs_api_scroll_attach", "target": "docs_api_dom_plane_domplane", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "canvasRect \u304c\u53e4\u304f\u306a\u308a DomPlane \u304c\u30c9\u30ea\u30d5\u30c8", "weight": 1.0}, {"source": "docs_api_scroll_lenis_integration", "target": "docs_api_dom_sync_gl_tick", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "lenis.raf() -> app.tick()", "weight": 1.0}, {"source": "docs_api_scroll_rafscroll_removed", "target": "docs_api_scroll_lenis_integration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api/scroll.md", "source_location": "RafScroll \u306f\u5ec3\u6b62\u3055\u308c\u305f", "weight": 1.0}, {"source": "docs_api_scroll_overscan", "target": "docs_api_dom_sync_gl_getters", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/api/scroll.md", "source_location": "logicalRect vs getViewPort()", "weight": 1.0}], "hyperedges": []}