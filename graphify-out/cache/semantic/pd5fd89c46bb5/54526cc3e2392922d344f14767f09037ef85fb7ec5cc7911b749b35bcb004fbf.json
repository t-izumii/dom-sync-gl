{"nodes": [{"id": "_claude_skills_graphify_references_query_query_expansion", "label": "Constrained query expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query CLI matches by case-folded substring + IDF with no stemming, synonyms or cross-language matching, so a wording mismatch returns 0 hits; the question is expanded only against tokens that actually exist in the graph vocabulary, never invented ones."}, {"id": "_claude_skills_graphify_references_query_bfs_dfs_traversal", "label": "BFS / DFS traversal modes", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BFS answers 'what is X connected to' (broad, nearest neighbors first); DFS answers 'how does X reach Y' (traces a chain, depth-limited to 6)."}, {"id": "_claude_skills_graphify_references_query_networkx_fallback", "label": "Inline NetworkX traversal fallback", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_save_result", "label": "save-result feedback loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "save-result", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving the answer (with the expanded-token trace) back into the graph means the next --update extracts the Q&A as a node, closing the feedback loop so future queries improve."}, {"id": "_claude_skills_graphify_references_query_work_memory_lessons", "label": "Work memory / LESSONS.md reflection", "file_type": "concept", "source_fi