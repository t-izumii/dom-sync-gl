{
  "name": "dom-sync-gl",
  "version": "0.0.3",
  "description": "domSyncGL — DOM ↔ WebGL synchronization with composable post effects, rAF-synced scroll, and touch inertia.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "npm run docs:dev",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "lil-gui": ">=0.19.0",
    "stats.js": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "lil-gui": {
      "optional": true
    },
    "stats.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.182.0",
    "jsdom": "^27.0.1",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "three": "^0.182.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "webgl",
    "three.js",
    "post-effect",
    "shader",
    "scroll-sync",
    "dom-sync",
    "domsyncgl"
  ]
}
